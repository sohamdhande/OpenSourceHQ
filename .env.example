# Local development. Copy to .env and replace the credentials as needed.
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/opensourcehq
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/opensourcehq

# Use a random secret of at least 32 characters. Never commit a populated .env file.
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
APP_ENCRYPTION_KEY=replace-with-a-different-random-secret-at-least-32-characters

# GitHub App: user authorization (GitHub sign-in / identity linking)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/github/callback

# GitHub App: server-to-server API access (repository sync; no student PATs)
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
# Optional local file path. Production should use a secret environment variable instead.
GITHUB_APP_PRIVATE_KEY_PATH=

# GitHub webhook verification
GITHUB_WEBHOOK_SECRET=

# Optional notification / email provider settings
EMAIL_FROM=notifications@opensourcehq.local
EMAIL_PROVIDER_API_KEY=

# Optional Inngest background job runner
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Protects scheduled public-repository polling jobs (generate a random 32+ character value).
CRON_SECRET=

# Google OAuth Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

