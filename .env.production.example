# Production deployment at https://org.nstsdc.org
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://org.nstsdc.org
GITHUB_CALLBACK_URL=https://org.nstsdc.org/api/auth/github/callback

# Supply the following through your hosting provider's encrypted secret manager.
DATABASE_URL=REPLACE_WITH_PRODUCTION_DATABASE_URL
DIRECT_URL=REPLACE_WITH_PRODUCTION_DIRECT_DATABASE_URL
AUTH_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
APP_ENCRYPTION_KEY=REPLACE_WITH_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
GITHUB_CLIENT_ID=REPLACE_WITH_GITHUB_APP_CLIENT_ID
GITHUB_CLIENT_SECRET=REPLACE_WITH_GITHUB_APP_CLIENT_SECRET
GITHUB_APP_ID=REPLACE_WITH_GITHUB_APP_ID
GITHUB_APP_SLUG=REPLACE_WITH_GITHUB_APP_SLUG
GITHUB_APP_PRIVATE_KEY=REPLACE_WITH_PEM_PRIVATE_KEY_WITH_ESCAPED_NEWLINES
GITHUB_WEBHOOK_SECRET=REPLACE_WITH_RANDOM_WEBHOOK_SECRET

CRON_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
